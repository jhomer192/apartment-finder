# --- Access control -------------------------------------------------------
# Only these addresses can hold a session. Removing one revokes their access
# on their next request. Comma separated.
ALLOWED_EMAILS=you@example.com,roommate@example.com

# Whoever can mint invite links from the UI.
ADMIN_EMAIL=you@example.com

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production; changing it logs everyone out.
SESSION_SECRET=

# --- Claude ---------------------------------------------------------------
# From `claude setup-token` on a machine logged into your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# --- Listing sources ------------------------------------------------------
# Craigslist 403s requests from datacenter IP ranges. Check your host first:
#   curl -s -o /dev/null -w "%{http_code}\n" -A "Mozilla/5.0" \
#     "https://sfbay.craigslist.org/search/apa?format=rss"
# Set to true only if that prints 200.
ENABLE_CRAIGSLIST=false

# --- Email sign-in --------------------------------------------------------
# Without these the sign-in form is disabled and links come from `npm run invite`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Tour reply tracking (optional) ----------------------------------------
# Read-only IMAP access to the inbox listers reply to. Mail that quotes a
# requested listing's address marks that tour request "replied"; nothing is
# sent, moved, or deleted. Use an app password where the provider offers one.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
REPLY_POLL_MINUTES=5

# --- New-listing alerts ---------------------------------------------------
# Each person picks their own filter and channels in the UI; these are the
# server-side limits. Email alerts reuse the SMTP settings above.
ALERT_INTERVAL_MINUTES=60
ALERTS_PER_RUN=8

# Channel > Integrations > Webhooks in Discord. Without it the Discord toggle
# stays disabled.
DISCORD_WEBHOOK_URL=

# --- Server ---------------------------------------------------------------
PORT=8787

# Public origin used in emailed sign-in links. Falls back to the request host.
PUBLIC_URL=
DATABASE_PATH=data/apartment-finder.db
SESSION_DAYS=30
INVITE_TTL_HOURS=72
LISTING_CACHE_MINUTES=30
