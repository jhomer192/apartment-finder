# --- Access control -------------------------------------------------------
# Only these addresses can hold a session. Removing one revokes their access
# on their next request. Comma separated.
ALLOWED_EMAILS=you@example.com,roommate@example.com

# Whoever can mint invite links from the UI.
ADMIN_EMAIL=you@example.com

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production; changing it logs everyone out.
SESSION_SECRET=

# --- Claude ---------------------------------------------------------------
# From `claude setup-token` on a machine logged into your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# --- Listing sources ------------------------------------------------------
# Craigslist 403s requests from datacenter IP ranges. Check your host first:
#   curl -s -o /dev/null -w "%{http_code}\n" -A "Mozilla/5.0" \
#     "https://sfbay.craigslist.org/search/apa?format=rss"
# Set to true only if that prints 200.
ENABLE_CRAIGSLIST=false

# --- Server ---------------------------------------------------------------
PORT=8787
DATABASE_PATH=data/apartment-finder.db
SESSION_DAYS=30
INVITE_TTL_HOURS=72
LISTING_CACHE_MINUTES=30
